```json
{
  "domain": "Automotive Cybersecurity",
  "problem": "CAN bus attack detection in autonomous vehicles",
  "task": "intrusion detection",
  "methods": ["Graph Neural Networks"],
  "concepts": ["CAN bus", "autonomous vehicles", "in-vehicle network security"],
  "entities": [],
  "datasets": [],
  "metrics": [],
  "constraints": ["automotive domain"],
  "research_intent": "method exploration",
  "terminology_variants": ["Controller Area Network", "CAN protocol", "vehicular network"],
  "method_variants": ["GNN", "GCN", "graph convolutional network", "graph attention network"],
  "expanded_queries": [
    "graph neural networks CAN bus attack detection",
    "GNN automotive intrusion detection",
    "graph-based CAN intrusion detection",
    "graph neural networks in-vehicle network security",
    "GNN autonomous vehicle cybersecurity",
