# ============================================================
# EWRGV – Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real API keys to version control.
# ============================================================

# ---- Application ----
DEBUG=false
LOG_LEVEL=INFO

# ---- LLM Provider ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-openai-api-key-here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ---- Embeddings ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-openai-api-key-here
EMBEDDING_DIMENSION=1536

# ---- Vector Store ----
# Options: faiss | chroma | qdrant
VECTOR_STORE=faiss
VECTOR_STORE_PATH=data/artifacts/vector_store

# ---- Database ----
DATABASE_URL=sqlite:///./data/artifacts/ewrgv.db

# ---- Literature Search ----
# Options: semantic_scholar | openalex
SEARCH_PROVIDER=semantic_scholar
SEARCH_API_KEY=

# ---- Retrieval ----
TOP_K=20
BM25_K=20
SEMANTIC_K=20
RERANK_TOP_N=10

# ---- Gap Detection ----
MAX_CANDIDATE_GAPS=20
TOP_K_GAPS=5

# ---- EWRGV Validation ----
MAX_VALIDATION_ITERATIONS=3
CONFIDENCE_THRESHOLD_VALID=0.70
CONFIDENCE_THRESHOLD_UNCERTAIN=0.40
