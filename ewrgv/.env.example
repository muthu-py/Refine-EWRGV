# ============================================================
# EWRGV – Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real API keys to version control.
# ============================================================

# ---- Application ----
DEBUG=false
LOG_LEVEL=INFO

# ---- LLM Provider ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30

# ---- Query Understanding & Expansion (Phase 2.1) ----
# Maximum number of expanded search queries generated per research question
QUERY_EXPANSION_MAX_QUERIES=8

# ---- Embeddings ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-openai-api-key-here
EMBEDDING_DIMENSION=1536

# ---- Vector Store ----
# Options: faiss | chroma | qdrant
VECTOR_STORE=faiss
VECTOR_STORE_PATH=data/artifacts/vector_store

# ---- Relational / Metadata Store ----
DATABASE_URL=sqlite:///./data/artifacts/ewrgv.db
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=papers

# ---- Literature Collection (Phase 2.2 / Phase 2.4) ----
# Enabled providers (comma-separated): semantic_scholar, openalex
LITERATURE_PROVIDERS=semantic_scholar,openalex

# Semantic Scholar (API key optional; anonymous access OK but rate-limited)
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_MAX_RESULTS=20

# OpenAlex (no auth required; email enables polite pool with higher limits)
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_EMAIL=you@example.com
OPENALEX_MAX_RESULTS=20

UNPAYWALL_EMAIL=you@example.com

# Overall collection limits
LITERATURE_REQUEST_TIMEOUT=30
LITERATURE_MAX_TOTAL_RESULTS=200

# ---- Retrieval ----
TOP_K=20
BM25_K=20
SEMANTIC_K=20
RERANK_TOP_N=10

# ---- Gap Detection ----
MAX_CANDIDATE_GAPS=20
TOP_K_GAPS=5

# ---- EWRGV Validation ----
MAX_VALIDATION_ITERATIONS=3
CONFIDENCE_THRESHOLD_VALID=0.70
CONFIDENCE_THRESHOLD_UNCERTAIN=0.40
